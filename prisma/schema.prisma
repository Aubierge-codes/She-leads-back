// SHE Leads Impact Dashboard - Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MANAGER
}

enum ParticipantStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum CleanupEventStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum WasteType {
  PLASTIC
  PAPER
  METAL
  GLASS
  ORGANIC
  OTHER
}

enum InventoryTransactionType {
  RESTOCK
  USAGE
  ADJUSTMENT
}

enum MeetingFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// ---------- Core ----------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  inventoryTransactions InventoryTransaction[]
  weeklyReports         WeeklyReport[]

  @@map("users")
}

model Community {
  id        String   @id @default(uuid())
  name      String
  state     String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  schools      School[]
  participants Participant[]
  cleanupEvents CleanupEvent[]

  @@map("communities")
}

model School {
  id                 String   @id @default(uuid())
  name               String
  location           String
  teacherCoordinator String   @map("teacher_coordinator")
  communityId        String?  @map("community_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  community          Community?          @relation(fields: [communityId], references: [id])
  participants       Participant[]
  environmentalClubs EnvironmentalClub[]
  weeklyReports      WeeklyReport[]

  @@map("schools")
}

model Participant {
  id          String            @id @default(uuid())
  name        String
  age         Int
  schoolId    String?           @map("school_id")
  communityId String?           @map("community_id")
  status      ParticipantStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  school    School?             @relation(fields: [schoolId], references: [id])
  community Community?          @relation(fields: [communityId], references: [id])
  attendances CleanupAttendance[]

  @@map("participants")
}

// ---------- Cleanup events ----------

model CleanupEvent {
  id          String             @id @default(uuid())
  title       String
  eventDate   DateTime           @map("event_date")
  eventTime   String?            @map("event_time")
  leader      String
  status      CleanupEventStatus @default(PLANNED)
  communityId String?            @map("community_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  community    Community?          @relation(fields: [communityId], references: [id])
  attendances  CleanupAttendance[]
  wasteRecords WasteRecord[]

  @@map("cleanup_events")
}

model CleanupAttendance {
  id            String   @id @default(uuid())
  participantId String   @map("participant_id")
  eventId       String   @map("event_id")
  attended      Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  participant Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  event       CleanupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([participantId, eventId])
  @@map("cleanup_attendance")
}

model WasteRecord {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  type      WasteType
  weightKg  Float     @map("weight_kg")
  bags      Int
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  event CleanupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("waste_records")
}

// ---------- Inventory ----------

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  unit        String   @default("units")
  quantity    Int      @default(0)
  minimumStock Int     @default(0) @map("minimum_stock")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  transactions InventoryTransaction[]

  @@map("inventory")
}

model InventoryTransaction {
  id            String                   @id @default(uuid())
  itemId        String                   @map("item_id")
  type          InventoryTransactionType
  quantity      Int
  note          String?
  performedById String?                  @map("performed_by_id")
  createdAt     DateTime                 @default(now()) @map("created_at")

  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy User?         @relation(fields: [performedById], references: [id])

  @@map("inventory_transactions")
}

// ---------- Environmental clubs ----------

model EnvironmentalClub {
  id               String           @id @default(uuid())
  schoolId         String           @map("school_id")
  president        String
  meetingFrequency MeetingFrequency @default(MONTHLY) @map("meeting_frequency")
  memberCount      Int              @default(0) @map("member_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("environmental_clubs")
}

// ---------- Weekly reports ----------

model WeeklyReport {
  id          String       @id @default(uuid())
  weekNumber  Int          @map("week_number")
  year        Int
  activities  String
  photos      String[]     @default([])
  status      ReportStatus @default(DRAFT)
  schoolId    String?      @map("school_id")
  submittedById String?    @map("submitted_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  school      School? @relation(fields: [schoolId], references: [id])
  submittedBy User?   @relation(fields: [submittedById], references: [id])

  @@unique([schoolId, weekNumber, year])
  @@map("weekly_reports")
}
