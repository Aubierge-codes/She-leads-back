# Copy to .env for local development. In production, set these in the hosting
# platform's environment settings instead of committing a .env file.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/she_leads_dashboard"

# Port the API listens on (frontend expects 4000 locally)
PORT=4000

# "production" enables the startup safety checks (JWT secret, seed password)
NODE_ENV=development

# Signs login tokens. Must be a random string of 32+ characters in production,
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"

# How long a login lasts before staff must sign in again (e.g. 1d, 12h)
JWT_EXPIRES_IN="1d"

# Public URL(s) of the frontend, comma-separated, no trailing slash.
# In production ONLY these websites may call the API from a browser.
FRONTEND_URL="http://localhost:3000"

# Login attempts allowed per minute per IP address (brute-force protection).
LOGIN_RATE_LIMIT=10

# Set to 1 when the API sits behind a hosting platform's load balancer/proxy
# (Render, Railway, Fly, Heroku, nginx...) so the real client IP is used.
# Leave unset when clients connect to the API directly.
# TRUST_PROXY=1

# Interactive API docs at /api are OFF in production. Set true to enable.
# ENABLE_SWAGGER=false

# First admin account, created by `npm run seed` (also runs on every deploy).
# SEED_ADMIN_PASSWORD is required to create the admin in production, and
# setting it later resets that admin's password (use to recover a lost login).
SEED_ADMIN_EMAIL="admin@ecogirlscollective.org"
SEED_ADMIN_PASSWORD=""
